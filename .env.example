# Copy this file to .env and fill in real values.
# .env is loaded automatically by `npm run dev` / `pnpm run dev`.

# PostgreSQL connection string for your local database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/baxi_brothers

# Clerk development keys (create a free dev app at https://clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Same publishable key, exposed to the Vite frontend
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
